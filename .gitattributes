# Pliki reguł zawierają polecenia powłoki wykonywane dosłownie.
# Zakończenie linii CRLF w poleceniu bash kończy się błędem w rodzaju
# "$'\r': command not found", więc w repozytorium i w kopii roboczej
# trzymamy LF niezależnie od systemu, na którym ktoś pracuje.

* text=auto eol=lf

*.yaml   text eol=lf
*.yml    text eol=lf
*.json   text eol=lf
*.py     text eol=lf
*.md     text eol=lf
*.sh     text eol=lf

# Skrypty PowerShell zapisujemy z CRLF — tego oczekują starsze wersje powłoki.
*.ps1    text eol=crlf

LICENSE  text eol=lf
NOTICE   text eol=lf
